#include<bits/stdc++.h>
using namespace std;
struct Node{
  int data;
  Node* next;
};

int main(){
Node* head=NULL;
  int n;
  cin>>n;
  for(int i=0;i<n;i++){
    int x;
    cin>>x;

    Node* newNode=new Node();
    newNode->data=x;
    newNode->next=head;
    head=newNode;
  }
  Node* temp=head;
  while(temp!=NULL){
    cout<<temp->data<<"  ";
    temp=temp->next;
  }
}
