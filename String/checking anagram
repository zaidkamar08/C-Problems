#include <bits/stdc++.h>
using namespace std;

int main() {
    string s1, s2;
    cin >> s1 >> s2;

    if (s1.length() != s2.length()) {
        cout << "Not Anagram";
        return 0;
    }

    unordered_map<char, int> mp;

    for (int i = 0; i < s1.length(); i++) {
        mp[s1[i]]++;
    }

    for (int i = 0; i < s2.length(); i++) {
        mp[s2[i]]--;
    }

    for (auto x : mp) {
        if (x.second != 0) {
            cout << "Not Anagram";
            return 0;
        }
    }

    cout << "Anagram";

    return 0;
}
