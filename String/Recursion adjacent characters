#include<bits/stdc++.h>
using namespace std;
string removeDuplicates(string s){
  if(s.empty()){
    return "";
  }
  for(int i=0;i<s.length()-1;i++){
    if(s[i]==s[i+1]){
      s.erase(i,2);
      return removeDuplicates(s);
    }

  }
  return s;

}
int main(){
  string s;
cin>>s;
cout<< removeDuplicates(s);
string ans=removeDuplicates(s);
if(ans.empty()){
  cout<<"empty string";
}
else{
  cout<<ans;
}
return 0;


}
